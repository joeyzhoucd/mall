<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-coupon</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-coupon</name>
    <description>mall-coupon</description>

    <dependencies>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-session-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-mq-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Redisson 4.x 是支持 Boot 4 的版本线（3.20.x 那条是给 Boot 2.7 的）。
             原来这里为了绕开 Boot 2.7 跟 redisson-spring-data-30 的不兼容，做了
             "排除 -30、手动引入 -27" 的操作；换到 Boot 4 之后 starter 自带的适配包
             就是对的，那套 exclusion + 手动指定全部删掉，交给 starter 自己带。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- 自适应并发限流。静态信号量本质上是「冷启动容量」和「热态容量」之间的折中
             （实测差一个数量级），而这两个值差这么多时任何固定值都是错的。
             详见 AdaptiveSeckillBulkhead 的类注释。

             为什么用这个库而不是 Resilience4j：Resilience4j 2.x 已经【移除】了
             AdaptiveBulkhead（jar 里 0 个 adaptive 相关类，实测确认）。
             Netflix concurrency-limits 是这个方向上的经典实现，Java 8 字节码、
             唯一的传递依赖是 slf4j-api（本来到处都有），
             跑在 Java 21 上没有兼容问题。
             需要知道的是它维护得很轻（0.5.4 是最新版），所以两个实现都保留、
             可以一键切回静态信号量。 -->
        <dependency>
            <groupId>com.netflix.concurrency-limits</groupId>
            <artifactId>concurrency-limits-core</artifactId>
            <version>0.5.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
