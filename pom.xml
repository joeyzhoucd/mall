<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mall</groupId>
    <artifactId>mall</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall</name>
    <description>mall root</description>
    <packaging>pom</packaging>
    <modules>
        <module>mall-admin</module>
        <module>mall-config</module>
        <module>mall-gateway</module>
        <module>mall-coupon</module>
        <module>mall-member</module>
        <module>mall-order</module>
        <module>mall-product</module>
        <module>mall-ware</module>
        <module>mall-common</module>
        <module>mall-auth</module>
        <module>mall-session-starter</module>
        <module>mall-mq-starter</module>
        <module>mall-cart</module>
        <module>mall-search</module>
        <module>mall-thirdparty</module>
        <!-- 集成测试用的容器定义。它没有主类，不是可部署模块，
             不要加进 .github/scripts/verify-fat-jars.sh 的清单。 -->
        <module>mall-test-support</module>
    </modules>

    <!-- 可根据需要自定义是否启用映射配置 -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <mall.version>0.0.1-SNAPSHOT</mall.version>
        <!-- 这里原来还有 maven.compiler.source/target=21。它们【不起作用】
             （被 settings.xml 的 jdk-1.8 profile 覆盖成 1.8，见下面 compiler 插件的说明），
             留着只会让人以为语言级别是在这里控制的，所以删掉。
             真正生效的是 maven-compiler-plugin 里字面量的 <release>21</release>。 -->
        <!-- Boot 4.1 是当前受支持的版本线（3.5 已于 2026-06-30 结束开源支持）。
             Boot 4 基于 Spring Framework 7，要求 Java 17+，这里用 Java 21（当前生产
             环境主流 LTS，虚拟线程从 21 起可用）。 -->
        <spring.boot.version>4.1.1</spring.boot.version>
        <!-- Spring Cloud 2025.1.x (Oakwood) 是配 Boot 4.0/4.1 的发布列车。 -->
        <spring.cloud.version>2025.1.3</spring.cloud.version>
        <!-- MyBatis-Plus 从 3.5.13 起提供 mybatis-plus-spring-boot4-starter，
             注意不能再用旧的 mybatis-plus-boot-starter（那个是给 Boot 2 的）。 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- Redisson 4.x 才支持 Boot 4；3.20.1 那条线是给 Boot 2.7 的。
             版本收敛到这里，mall-product 和 mall-coupon 共用。 -->
        <redisson.version>4.7.0</redisson.version>
        <!-- lombok / mysql-connector-j / httpclient5 / junit 这几个的版本都由
             spring-boot-dependencies 统一管理，不在这里再钉一遍——原来钉死的
             lombok 1.18.24 不支持 Java 21，这类版本漂移交给 BOM 更省心。 -->
        <!-- surefire 排除哪些标签。走一个属性而不是把 integration 直接写死在插件配置里 ——
             原因见下面 integration profile 的说明：Maven 的插件配置合并规则决定了
             【空元素覆盖不掉父配置】，必须靠属性替换才能真正清空。 -->
        <mall.surefire.excludedGroups>integration</mall.surefire.excludedGroups>
        <aws.sdk.version>2.54.6</aws.sdk.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK v2：用来访问对象存储。
                 这里选它不是因为要上 AWS，而是因为 S3 的 API 事实上已经是对象存储的
                 通用协议 —— MinIO、Cloudflare R2、腾讯云 COS、以及阿里云 OSS 自己
                 都提供 S3 兼容端点。换成它之后，同一份代码在本地（MinIO）、
                 阿里云、AWS 上都不用改，只改配置里的 endpoint 和 region。
                 而 aliyun-sdk-oss 把代码绑死在一家云上，这是本次去阿里化要拆掉的
                 最后一个依赖（全仓 grep com.alibaba/aliyun 只剩它）。 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Boot 4 专用的 starter；旧的 mybatis-plus-boot-starter 是给 Boot 2 的，
                 不能混用（官方文档明确说引入 MyBatis-Plus 之后不要再单独引入
                 mybatis / mybatis-spring-boot-starter，会因版本差异出问题）。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 这里原来还钉了 mysql-connector-java（旧坐标，已废弃，新坐标是
                 com.mysql:mysql-connector-j）、httpcore 4.x、commons-lang 2.6（2011 年的
                 包，只用到 isBlank，Java 11+ 有 String.isBlank() 可以直接替代）、
                 以及 lombok 1.18.24（不支持 Java 21）。全部改为交给
                 spring-boot-dependencies 管理或直接删除，见 properties 里的说明。
                 spring-cloud-alibaba 的 BOM 也删掉了——它没有 Boot 4 版本，这也是
                 这次必须把 Nacos 一起换掉、不能分两步走的原因。 -->

            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-common</artifactId>
                <version>${mall.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 可根据需要自定义是否启用映射配置 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 版本对齐 Boot 4.1.1 BOM 声明的 3.15.0。原来是 3.8.1（2019 年），
                     它有一个会静默吞掉编译选项的行为，实际踩到了：

                     3.8.1 里 -parameters 到底加不加，取决于插件的 <target> 是否 >= 1.8，
                     而它【不看 <release>】。本 pom 为了不被 settings.xml 覆盖，把
                     <source>/<target> 换成了字面量 <release>21</release>，于是插件的
                     target 取自己的默认值 1.6，门槛不过，-parameters 被悄悄丢掉。
                     javac 命令行实测对比（mvn -X）：
                       有 -parameters：-g -parameters -nowarn （release 21） -encoding UTF-8
                       无 -parameters：-g -nowarn （release 21） -encoding UTF-8

                     本地长期没暴露纯属巧合：Maven 安装目录 conf/settings.xml 里那个
                     activeByDefault 的 jdk-1.8 profile 把 maven.compiler.target 设成了 1.8，
                     恰好让门槛通过。CI 没有那个 profile，于是同一份源码在 CI 编不出参数名，
                     表现是 mall-order/mall-ware 启动时按名字注入 Queue 失败。
                     也就是说「把 source/target 换成 release」这个本身正确的改动，
                     在旧插件上反而关掉了另一个选项 —— 两个改动单看都对，组合起来出问题。

                     BOM 的 pluginManagement 通过 import 是拿不到的（只有真正继承 parent
                     才继承插件管理），所以这里必须自己写版本号。 -->
                <version>3.15.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <!-- 用字面量 21 的 <release>，而不是 <source>/<target> 加属性引用。
                         两个原因：

                         1) 属性引用会被 settings.xml 里的 profile 覆盖，而且覆到就静默生效。
                            本机 Maven 安装目录的 conf/settings.xml 里有个 id=jdk-1.8 的 profile，
                            带 <activeByDefault>true</activeByDefault>（跟 JDK 版本无关，一直生效），
                            里面把 maven.compiler.source/target 设成 1.8。settings.xml 的 profile
                            属性优先级高于 pom 属性，所以本 pom 里写 21 也没用 ——
                            实测 help:evaluate 求出来是 1.8，编译器报的是 source 8。
                            后果是【本地按 Java 8 语言级别编译，CI（GitHub Actions 用默认 settings）
                            按 21 编译】，同一份代码两边的语言级别不一样：本地写不了 record、
                            var、switch 表达式，而 CI 能过；反过来别人在 CI 上加的新语法，
                            本地构建会突然编不过。字面量不受 settings.xml 影响。
                            没有去改那个 settings.xml：它是这台机器的全局配置，会影响其他项目，
                            修在自己的 pom 里才是自包含的做法。

                         2) release 参数比 source/target 更严格也更正确：它同时限定语言级别和
                            【可用的 JDK API 集合】。而 source/target 只管语法，API 仍然是当前 JDK 的
                            全集，于是可能编出「本地 JDK 能编、目标运行时没这个 API」的产物。
                            既然要求 Java 21，就用 release 一次说清。 -->
                    <release>21</release>
                    <!-- -parameters：把方法参数名写进 class 文件。这是必须的，不是可选优化。
                         Spring 在"一个注入点有多个候选 bean"时按【参数名】匹配 bean 名。
                         Spring Framework 6.1 之前，参数名拿不到还能退回去读字节码里的
                         LocalVariableTable 调试信息（Maven 默认带 -g 所以一直有），
                         6.1 起【移除了这个回退】，参数名不在 class 文件里就直接解析失败。

                         本项目没继承 spring-boot-starter-parent（只 import 了 BOM），
                         所以拿不到它默认配好的 -parameters，一直是缺的。Boot 2.7 时代靠
                         上面那个回退在跑，升到 Boot 4 就炸了：
                           Parameter 0 of method seckillOrderBinding ... required a single
                           bean, but 3 were found
                         mall-order 和 mall-ware 都因此启动失败。

                         这修的是【一整类】问题：任何按参数名区分多个同类型 bean 的地方
                         都受影响，只是要走到那个配置类才会暴露。
                         验证方式：javap -v 看目标 class 里有没有 MethodParameters 段。 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- 必须显式 pin 版本。本项目不继承 spring-boot-starter-parent（只 import 了
                     spring-boot-dependencies 这个 BOM），而【通过 import 引入的 BOM 只带
                     dependencyManagement，不带 pluginManagement 也不带 properties】——
                     Boot 4.1.1 的 BOM 里其实写了 maven-surefire-plugin.version=3.5.6，
                     但那在它的 pluginManagement 里，import 拿不到。
                     于是 surefire 回落到 Maven 3.8.4 自带的默认值 2.12.4（2012 年的版本）。

                     后果非常隐蔽：surefire 的 JUnit Platform 支持是 2.22.0 才加的，
                     2.12.4 【认不出任何 JUnit 5 测试】。它不会报错，只是一个测试都不执行，
                     然后 mvn 照常打印 BUILD SUCCESS。也就是说在 pin 版本之前，
                     这个项目写多少 JUnit 5 测试都等于没写，而且看不出来。
                     （之前一直用 -DskipTests 构建，所以从没暴露。）
                     版本对齐 Boot 4.1.1 BOM 声明的 3.5.6。 -->
                <version>3.5.6</version>
                <configuration>
                    <!-- 默认跳过打了 @Tag("integration") 的测试。它们用 Testcontainers 起真实的
                         MySQL/Redis/RabbitMQ/Elasticsearch，需要本机有 Docker —— 本项目的开发机
                         没有 Docker Desktop，所以默认跑不了。
                         CI 里有一个独立的 integration-test 作业执行它们
                         （mvn -B test -Pintegration -Dgroups=integration），
                         并且 build 作业依赖它 —— 也就是说集成测试挂了会挡住发布。
                         这样默认的 mvn test 只跑不依赖外部环境的测试，秒级完成、随时可跑。 -->
                    <excludedGroups>${mall.surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <jvmArguments>
                        -Xmx512m -Xms256m
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pintegration：把集成测试也跑上。
             容器定义在 mall-test-support 模块，各服务按自己【实测】需要的中间件
             @Import 对应的内部类（依据是运行中 pod 的 /actuator/health 组件明细，
             不是按 classpath 猜的 —— mall-common 会把 mybatis+MySQL 驱动带给
             并不需要数据库的 mall-gateway/mall-auth/mall-cart）。
             需要 Docker，所以主要在 CI 的 integration-test 作业里跑。

             【为什么是改属性，而不是在这里写 <excludedGroups></excludedGroups>】
             第一版就是那么写的，结果是【一个集成测试都没跑，而 mvn 报 BUILD SUCCESS】。
             Maven 合并插件配置时（Xpp3Dom.mergeXpp3Dom），如果 dominant 一侧的元素
             既没有值也没有子元素，就会退回用 recessive 一侧的值 ——
             也就是说空元素等于"没写"，父层的 integration 原样保留。
             改成属性替换：属性值为空时 excludedGroups 就是空字符串，是一个"有值"的覆盖。

             这个坑是被 CI 里那条「断言测试确实跑了」的检查抓出来的。没有那条检查的话，
             这个作业会一直绿着，而它一个测试都没执行 —— 和这个项目之前踩过的
             surefire 2.12.4 认不出 JUnit 5 是完全同一类问题。 -->
        <profile>
            <id>integration</id>
            <properties>
                <mall.surefire.excludedGroups></mall.surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
