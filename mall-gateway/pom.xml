<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-gateway</name>
    <description>mall-gateway</description>

    <dependencies>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                  <!-- 这个服务不连关系型数据库，把 mall-common 带来的持久化那一套也排掉。
                       原来是靠 @SpringBootApplication(exclude = DataSourceAutoConfiguration.class)
                       绕过去的 —— 那只是让 Boot 别去建 DataSource，jar 里那 20 多 MiB 的
                       MyBatis-Plus + JDBC + MySQL 驱动照样在、启动时照样要被扫描。
                       对一个正在优化冷启动的项目来说，带着一整套用不到的持久化框架是纯负担。
                       artifact 名随 Boot 4 迁移变过（mybatis-plus-boot-starter →
                       mybatis-plus-spring-boot4-starter，mysql:mysql-connector-java →
                       com.mysql:mysql-connector-j），写旧名字不报错但排除会【静默失效】。 -->
                  <exclusion>
                      <groupId>com.baomidou</groupId>
                      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                  </exclusion>
                  <exclusion>
                      <groupId>com.baomidou</groupId>
                      <artifactId>mybatis-plus-jsqlparser</artifactId>
                  </exclusion>
                  <exclusion>
                      <groupId>com.mysql</groupId>
                      <artifactId>mysql-connector-j</artifactId>
                  </exclusion>
            </exclusions>
        </dependency>
        <!-- Spring Cloud 2025.1（= Gateway 5.0）把网关的坐标按"响应式 / MVC"两种
             web 栈拆开了，旧的 spring-cloud-starter-gateway 已删除。我们这个网关是
             响应式的（WebFlux），所以用 -server-webflux 这个。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- 限流用：Spring Cloud Gateway 自带的 RequestRateLimiter 过滤器要靠这个操作 Redis
             （令牌桶算法本身就是一段 Lua 脚本，框架内置，不用自己写）。网关是 WebFlux/
             reactive 技术栈，要用 reactive 版本的 Redis starter，不能跟其他服务一样用
             阻塞版的 spring-boot-starter-data-redis。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
    
        <!-- 集成测试的容器定义。test 作用域 —— 它不会进任何生产镜像。 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
