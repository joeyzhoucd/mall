<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mall-session-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-session-starter</name>
    <description>Mall Session Starter (Spring Session Redis)</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!-- Session 存 Redis 用 JSON 序列化，需要 Jackson 3 的 ObjectMapper
             （GenericJacksonJsonRedisSerializer 的构造参数）。spring-data-redis
             对 Jackson 的依赖是 optional 的，不会传递过来，得显式声明。
             注意 groupId 是 tools.jackson.core（Jackson 3），不是老的
             com.fasterxml.jackson.core；版本由 Boot BOM 管理。 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 这个模块之前没有任何测试。加测试的直接原因：序列化器少开一个
             enableDefaultTyping 就会让整个会员登录态静默失效（详见
             MallSessionAutoConfiguration 的注释），而这种错误在编译期、
             启动期、健康检查里全都看不出来，只能靠单元测试兜住。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

