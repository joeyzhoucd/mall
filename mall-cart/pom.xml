<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-cart</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-cart</name>
    <description>mall-cart</description>

    <dependencies>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <!-- 这个服务不连关系型数据库，把 mall-common 带来的持久化那一套排掉。
                 原来是靠 @SpringBootApplication(exclude = DataSourceAutoConfiguration.class)
                 绕过去的 —— 那只是让 Boot 别去建 DataSource，jar 里那 20 多 MiB 的
                 MyBatis-Plus + JDBC + MySQL 驱动照样在，启动时照样要被扫描。
                 对一个正在优化冷启动的项目来说，带着一整套用不到的持久化框架是纯负担。
                 artifact 名随 Boot 4 迁移变过（mybatis-plus-boot-starter →
                 mybatis-plus-spring-boot4-starter，mysql:mysql-connector-java →
                 com.mysql:mysql-connector-j），写旧名字不报错但排除会【静默失效】。 -->
            <exclusions>
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus-jsqlparser</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-session-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    
        <!-- 集成测试的容器定义。test 作用域 —— 不会进任何生产镜像。 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- API 文档。mall-common 把 springdoc 声明成 optional（不传递），
             所以要用的服务自己引一遍 —— 这是有意的，避免像以前 MyBatis 那样
             撒给不需要的服务。标题等信息由 mall-common 的 MallOpenApiAutoConfiguration 提供。
             文档地址：/v3/api-docs 和 /swagger-ui.html，都不在网关路由里，只在集群内可达。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

