<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-thirdparty</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-thirdparty</name>
    <description>mall-thirdparty</description>
    <dependencies>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <!-- 这个服务不连关系型数据库，排掉 mall-common 带来的持久化依赖。
                 注意 artifact 名随 Boot 4 迁移变了（mybatis-plus-boot-starter →
                 mybatis-plus-spring-boot4-starter，mysql:mysql-connector-java →
                 com.mysql:mysql-connector-j），写旧名字不报错但排除会静默失效。 -->
            <exclusions>
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus-jsqlparser</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 对象存储走 S3 API。
             选它不是因为要上 AWS，而是因为 S3 的 API 事实上已经是对象存储的通用协议 ——
             MinIO、Cloudflare R2、腾讯云 COS，以及阿里云 OSS 自己都提供 S3 兼容端点。
             同一份代码在本地（MinIO）、阿里云、AWS 上都不用改，只改 endpoint 和 region。
             原来用的 aliyun-sdk-oss 把代码绑死在一家云上，是本次去阿里化要拆的
             最后一个依赖（全仓 grep com.alibaba / aliyun 只剩它）。
             只引 s3 这一个模块，不引整个 aws-sdk —— 后者会把几百个服务的客户端都拉进来。
             版本由根 pom 的 software.amazon.awssdk:bom 管理。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
    
        <!-- 集成测试的容器定义。test 作用域 —— 它不会进任何生产镜像。 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- API 文档。mall-common 把 springdoc 声明成 optional（不传递），
             所以要用的服务自己引一遍 —— 这是有意的，避免像以前 MyBatis 那样
             撒给不需要的服务。标题等信息由 mall-common 的 MallOpenApiAutoConfiguration 提供。
             文档地址：/v3/api-docs 和 /swagger-ui.html，都不在网关路由里，只在集群内可达。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
