<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mall.product.dao.AttrGroupDao">

    <!-- 可根据需要自定义是否启用映射配置 -->
    <resultMap type="com.mall.product.entity.AttrGroupEntity" id="attrGroupMap">
        <result property="attrGroupId" column="attr_group_id"/>
        <result property="attrGroupName" column="attr_group_name"/>
        <result property="sort" column="sort"/>
        <result property="descript" column="descript"/>
        <result property="icon" column="icon"/>
        <result property="categoryId" column="category_id"/>
    </resultMap>

    <resultMap id="SpuItemAttrGroupVo" type="com.mall.product.vo.SpuItemAttrGroupVo">
        <result column="attr_group_name" property="groupName"/>
        <collection property="attrs" ofType="com.mall.product.vo.SpuBaseAttrVo">
            <result column="attr_name" property="attrName"/>
            <result column="attr_value" property="attrValue"/>
        </collection>
    </resultMap>

    <select id="getAttrGroupWithAttrsBySpuId" resultMap="SpuItemAttrGroupVo">
        SELECT
            ag.attr_group_name,
            attr.attr_name,
            pav.attr_value
        FROM pms_attr_group ag
        LEFT JOIN pms_attr_attrgroup_relation aar ON ag.attr_group_id = aar.attr_group_id
        LEFT JOIN pms_attr attr ON aar.attr_id = attr.attr_id
        LEFT JOIN pms_product_attr_value pav ON attr.attr_id = pav.attr_id
        WHERE ag.category_id = #{catalogId} AND pav.spu_id = #{spuId}
    </select>
</mapper>
