<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mall.admin.dao.SysRoleMenuDao">

    <!-- ORDER BY id 不是可选的。前端保存角色时发的是
         [...全勾选的菜单id, -666666, ...半勾选的菜单id]，
         回显时靠 indexOf(-666666) 的位置把列表截断成两段。
         所以这里必须按插入顺序返回，而且【不能过滤掉 -666666】。
         详见 openapi/admin-api.yaml 第六条。 -->
    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id
          FROM sys_role_menu
         WHERE role_id = #{roleId}
         ORDER BY id
    </select>

</mapper>
