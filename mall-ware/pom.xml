<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mall</groupId>
        <artifactId>mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-ware</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-ware</name>
    <description>mall-ware</description>

    <dependencies>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-mq-starter</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- 库存热点读的多级缓存要用（2026-09-06 新增）。
             必须在这里显式声明：mall-common 里那个是 <optional>true</optional>，
             不会传递下来。少了它，classpath 上没有 StringRedisTemplate 这个类，
             MultiLevelCacheAutoConfiguration 的 @ConditionalOnClass 会整段跳过，
             于是 WareHotCacheInvalidator 拼不出来、整个上下文起不来。
             —— 这正是 2026-09-06 CI 集成测试逮到的那个失败。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 集成测试的容器定义。test 作用域 —— 它不会进任何生产镜像。 -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- API 文档。mall-common 把 springdoc 声明成 optional（不传递），
             所以要用的服务自己引一遍 —— 这是有意的，避免像以前 MyBatis 那样
             撒给不需要的服务。标题等信息由 mall-common 的 MallOpenApiAutoConfiguration 提供。
             文档地址：/v3/api-docs 和 /swagger-ui.html，都不在网关路由里，只在集群内可达。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
